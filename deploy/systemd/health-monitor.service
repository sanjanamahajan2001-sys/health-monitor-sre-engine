[Unit]
Description=Health Monitor Service
Documentation=https://github.com/health-monitor
After=network.target

[Service]
Type=simple
User=health-monitor
Group=health-monitor
WorkingDirectory=/opt/health-monitor
ExecStart=/opt/health-monitor/health-monitor --foreground
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=health-monitor

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/health-monitor /var/log/health-monitor

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
Alias=health-monitor.service
